# Copy this file to .env.portfolio (which is ignored by Git) and fill in local values.
# Never put PORTFOLIO_SUPABASE_SERVICE_ROLE_KEY into hub/, GitHub Pages, or a public repository.
PORTFOLIO_SUPABASE_URL=https://your-project-ref.supabase.co
PORTFOLIO_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORTFOLIO_OWNER_EMAIL=you@example.com
